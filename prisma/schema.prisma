// Prisma Schema untuk Zahdan Kamal Sentosa (ZKS) Catering
// Sesuai Spesifikasi Keputusan Arsitektur Fase 1 & Keputusan Final (docs/agent/decisions.md)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  WAITING_ADMIN_CONFIRMATION
  CONFIRMED_AWAITING_PAYMENT
  DP_PAID
  FULLY_PAID
  IN_PREPARATION
  IN_DELIVERY
  COMPLETED
  EXPIRED_UNCONFIRMED_BY_ADMIN
  EXPIRED_PAYMENT_TIMEOUT
  REJECTED_BY_ADMIN
  CANCELLED_BY_ADMIN_REFUND_REQ
  CANCELLED_BY_CUSTOMER
  CANCELLED_DP_FORFEITED
  CANCELLED_FULL_REFUND_PENDING
  REFUNDED
}

enum PaymentType {
  DP
  SETTLEMENT
  FULL
}

enum PaymentStatus {
  PENDING
  SETTLED
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

model Admin {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stockMovements   StockMovement[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  menuItems MenuItem[]
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Int
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id                  Int         @id @default(autoincrement())
  orderCode           String      @unique
  accessTokenHash     String      @unique
  customerName        String
  customerPhone       String
  customerAddress     String
  customerEmail       String?
  // eventDate menyimpan tanggal dan jam acara; perhitungan hari kalender memakai zona Asia/Jakarta di kode aplikasi
  eventDate           DateTime
  notes               String?
  totalPcs            Int
  subtotal            Int
  shippingFee         Int?
  totalAmount         Int?
  dpAmount            Int?
  status              OrderStatus @default(WAITING_ADMIN_CONFIRMATION)
  termsAcceptedAt     DateTime?
  confirmedAt         DateTime?
  initialPaymentDueAt DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  forfeitedAmount     Int?
  refundAmount        Int?
  refundedAt          DateTime?
  isAnonymized        Boolean     @default(false)
  anonymizedAt        DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]
  payments            Payment[]

  @@index([status])
  @@index([eventDate])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Int
  subtotal   Int
  notes      String?
}

model Payment {
  id                    Int           @id @default(autoincrement())
  orderId               Int
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentRef            String        @unique
  paymentType           PaymentType
  amount                Int
  status                PaymentStatus @default(PENDING)
  providerTransactionId String?
  paymentUrl            String?
  paymentChannel        String?
  sessionExpiresAt      DateTime?
  settledAt             DateTime?
  gatewayName           String?
  maskedResponse        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([gatewayName, providerTransactionId])
  @@index([orderId])
}

model RateLimitAttempt {
  id        Int      @id @default(autoincrement())
  ipHmac    String
  action    String
  createdAt DateTime @default(now())

  @@index([ipHmac, createdAt])
}

// ---------------------------------------------------------------------------
// Gudang: katalog bahan dan mutasi stok.
// Stok tidak disimpan sebagai angka; stok = jumlah mutasi masuk ke lokasi dikurangi mutasi keluar dari lokasi.
// ---------------------------------------------------------------------------

enum StockMovementType {
  IN // dari supplier: toLocation terisi
  OUT // dipakai produksi atau dibuang: fromLocation terisi
  TRANSFER // pindah lokasi: fromLocation dan toLocation terisi
  ADJUSTMENT // koreksi stock opname: salah satu lokasi terisi (tambah ke toLocation, kurang dari fromLocation)
}

model IngredientCategory {
  id        Int              @id @default(autoincrement())
  slug      String           @unique
  name      String
  sortOrder Int              @default(0)
  types     IngredientType[]
}

model IngredientType {
  id          Int                @id @default(autoincrement())
  categoryId  Int
  category    IngredientCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  sortOrder   Int                @default(0)
  ingredients Ingredient[]

  @@unique([categoryId, name])
}

model StorageLocation {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  name          String
  note          String?
  ingredients   Ingredient[]
  receipts      GoodsReceipt[]
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")
}

model Supplier {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  contactName  String?
  phone        String?
  area         String?
  paymentTerms String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ingredients  Ingredient[]
  orders       PurchaseOrder[]
}

model Ingredient {
  id                Int             @id @default(autoincrement())
  code              String          @unique
  name              String
  typeId            Int
  type              IngredientType  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  unit              String
  defaultLocationId Int
  defaultLocation   StorageLocation @relation(fields: [defaultLocationId], references: [id], onDelete: Restrict)
  minStock          Decimal         @default(0) @db.Decimal(12, 3)
  // Harga beli terakhir per satuan, dalam rupiah
  lastPrice         Int             @default(0)
  supplierId        Int?
  supplier          Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  movements         StockMovement[]
  requestLines      PurchaseRequestLine[]
  orderLines        PurchaseOrderLine[]

  @@index([typeId])
}

model StockMovement {
  id             Int               @id @default(autoincrement())
  ingredientId   Int
  ingredient     Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type           StockMovementType
  // Selalu positif; arah ditentukan oleh fromLocation / toLocation
  quantity       Decimal           @db.Decimal(12, 3)
  fromLocationId Int?
  fromLocation   StorageLocation?  @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   Int?
  toLocation     StorageLocation?  @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  reference      String?
  note           String?
  createdById    Int?
  createdBy      Admin?            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([ingredientId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Pengadaan: permintaan pembelian (PR), pesanan pembelian (PO), dan penerimaan barang.
// Nomor tampilan (PR-0001, PO-0001, GRN-0001) diturunkan dari id, jadi tidak disimpan.
// ---------------------------------------------------------------------------

enum PurchaseRequestStatus {
  PENDING // menunggu persetujuan
  APPROVED // disetujui, belum jadi PO
  REJECTED
  ORDERED // sudah dibuatkan PO
}

enum PurchaseOrderStatus {
  SENT // dikirim ke supplier, menunggu barang
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseRequest {
  id           Int                   @id @default(autoincrement())
  requestedBy  String
  reason       String
  neededBy     DateTime
  status       PurchaseRequestStatus @default(PENDING)
  decisionNote String?
  decidedAt    DateTime?
  createdById  Int?
  createdBy    Admin?                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  lines        PurchaseRequestLine[]
  order        PurchaseOrder?

  @@index([status])
}

model PurchaseRequestLine {
  id           Int             @id @default(autoincrement())
  requestId    Int
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  ingredientId Int
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal         @db.Decimal(12, 3)

  @@unique([requestId, ingredientId])
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  supplierId   Int
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requestId    Int?                @unique
  request      PurchaseRequest?    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  status       PurchaseOrderStatus @default(SENT)
  expectedDate DateTime?
  note         String?
  cancelledAt  DateTime?
  createdById  Int?
  createdBy    Admin?              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]

  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id               Int                @id @default(autoincrement())
  orderId          Int
  order            PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ingredientId     Int
  ingredient       Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity         Decimal            @db.Decimal(12, 3)
  // Harga per satuan yang disepakati, dalam rupiah
  unitPrice        Int
  // Jumlah yang sudah diterima dan lolos cek kualitas
  receivedQuantity Decimal            @default(0) @db.Decimal(12, 3)
  receiptLines     GoodsReceiptLine[]

  @@unique([orderId, ingredientId])
}

model GoodsReceipt {
  id           Int                @id @default(autoincrement())
  orderId      Int
  order        PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  locationId   Int
  location     StorageLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  note         String?
  receivedById Int?
  receivedBy   Admin?             @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  lines        GoodsReceiptLine[]

  @@index([orderId])
  @@index([createdAt])
}

model GoodsReceiptLine {
  id               Int               @id @default(autoincrement())
  receiptId        Int
  receipt          GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  orderLineId      Int
  orderLine        PurchaseOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  // Lolos cek kualitas: masuk stok sebagai mutasi IN
  acceptedQuantity Decimal           @db.Decimal(12, 3)
  // Ditolak saat cek kualitas: tidak masuk stok
  rejectedQuantity Decimal           @default(0) @db.Decimal(12, 3)
  note             String?

  @@index([receiptId])
}
